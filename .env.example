# Database connection (SQLite default for zero-setup local development, PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# 32-byte hex key for AES-256-GCM encryption of Resend API keys
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Secret key for JWT session cookies
AUTH_SECRET="openresend-dev-auth-secret-session-key-minimum-32-chars-long"

# Host configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
